# === Required ===
# Supabase
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJxxxx

# Mapbox
VITE_MAPBOX_TOKEN=pk.xxxxx

# === Optional ===
# microCMS (for blog/news content)
VITE_MICROCMS_API_KEY=

# Debug mode (set to "true" to enable GPS spoofing etc.)
VITE_ENABLE_DEBUG_MODE=

# Image processing
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_QUALITY=0.8

# Sentry (error tracking, optional)
VITE_SENTRY_DSN=
